{
  "$defs": {
    "MediaRef": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Sha256"
        },
        "source_batch_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Batch Id"
        },
        "role": {
          "default": "original",
          "enum": [
            "original",
            "screenshot_preview"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256",
        "source_batch_id"
      ],
      "title": "MediaRef",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "capture_method": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Capture Method",
          "type": "string"
        },
        "locator": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locator"
        },
        "notes": {
          "anyOf": [
            {
              "maxLength": 4000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "required": [
        "source",
        "capture_method"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "Reply": {
      "additionalProperties": false,
      "properties": {
        "message_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Message Id",
          "type": "string"
        },
        "batch_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Batch Id",
          "type": "string"
        }
      },
      "required": [
        "message_id",
        "batch_id"
      ],
      "title": "Reply",
      "type": "object"
    },
    "Sender": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Id"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 240,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Name"
        },
        "is_self": {
          "title": "Is Self",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "is_self"
      ],
      "title": "Sender",
      "type": "object"
    },
    "Voice": {
      "additionalProperties": false,
      "properties": {
        "original_duration": {
          "anyOf": [
            {
              "maxLength": 240,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Original Duration"
        },
        "duration_ms": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Ms"
        },
        "transcripts": {
          "items": {
            "$ref": "#/$defs/VoiceTranscript"
          },
          "maxItems": 20,
          "title": "Transcripts",
          "type": "array"
        }
      },
      "title": "Voice",
      "type": "object"
    },
    "VoiceTranscript": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 200000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "source": {
          "const": "wecom_ui",
          "title": "Source",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      },
      "required": [
        "text",
        "source",
        "provenance"
      ],
      "title": "VoiceTranscript",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Id",
      "type": "string"
    },
    "id_kind": {
      "enum": [
        "source",
        "generated"
      ],
      "title": "Id Kind",
      "type": "string"
    },
    "source_id": {
      "anyOf": [
        {
          "maxLength": 240,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Source Id"
    },
    "sender": {
      "$ref": "#/$defs/Sender"
    },
    "sent_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Sent At"
    },
    "original_time": {
      "anyOf": [
        {
          "maxLength": 240,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Original Time"
    },
    "order": {
      "minimum": 0,
      "title": "Order",
      "type": "integer"
    },
    "type": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Type",
      "type": "string"
    },
    "text": {
      "anyOf": [
        {
          "maxLength": 200000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Text"
    },
    "reply_to": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reply"
        },
        {
          "type": "null"
        }
      ]
    },
    "media": {
      "items": {
        "$ref": "#/$defs/MediaRef"
      },
      "maxItems": 100,
      "title": "Media",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "voice": {
      "anyOf": [
        {
          "$ref": "#/$defs/Voice"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "id",
    "id_kind",
    "source_id",
    "sender",
    "sent_at",
    "original_time",
    "order",
    "type",
    "text",
    "reply_to",
    "media",
    "provenance"
  ],
  "title": "Message",
  "type": "object"
}
